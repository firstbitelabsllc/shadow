{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidux.local/evaluations/vidux-vs-native-bakeoff/reviewer-score.schema.json",
  "title": "Vidux Bake-Off Blinded Reviewer Score",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "score_id",
    "run_id",
    "fixture_id",
    "reviewer_role",
    "blind_packet_hash",
    "scores",
    "pass_fail_override",
    "confidence",
    "notes"
  ],
  "properties": {
    "score_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"
    },
    "fixture_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"
    },
    "reviewer_role": {
      "type": "string",
      "enum": [
        "correctness_1",
        "correctness_2",
        "edge_case",
        "regression",
        "tests",
        "test_gaming",
        "architecture",
        "repo_pattern",
        "maintainability",
        "ux_runtime",
        "accessibility_performance",
        "security_safety",
        "data_persistence",
        "observability_proof",
        "claim_honesty",
        "convergence",
        "resume_handoff",
        "token_cost",
        "product_owner",
        "red_team"
      ]
    },
    "blind_packet_hash": {
      "type": "string",
      "minLength": 16
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctness",
        "completeness",
        "reliability_tests",
        "maintainability_repo_fit",
        "user_runtime_quality",
        "proof_honesty",
        "resume_convergence"
      ],
      "properties": {
        "correctness": { "type": "number", "minimum": 1, "maximum": 5 },
        "completeness": { "type": "number", "minimum": 1, "maximum": 5 },
        "reliability_tests": { "type": "number", "minimum": 1, "maximum": 5 },
        "maintainability_repo_fit": { "type": "number", "minimum": 1, "maximum": 5 },
        "user_runtime_quality": { "type": "number", "minimum": 1, "maximum": 5 },
        "proof_honesty": { "type": "number", "minimum": 1, "maximum": 5 },
        "resume_convergence": { "type": "number", "minimum": 1, "maximum": 5 }
      }
    },
    "pass_fail_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies", "reason"],
      "properties": {
        "applies": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "notes": {
      "type": "string"
    }
  }
}
