# Release-artifact allowlist, git-native. `git archive` ships the product;
# everything marked export-ignore is development-only and stays in the clone.
# This replaces npm's `files` field (removed 2026-08-09) — same guarantee,
# no package manager: the artifact stays small, public, and installable.
.github/            export-ignore
scripts/shadow-ci.py export-ignore
tests/              export-ignore
.gitattributes      export-ignore
.gitleaks.toml      export-ignore
PLAN.md             export-ignore
SOURCE_REF          export-subst
docs/plan-archive/ export-ignore
scripts/shadow-brief.py export-ignore
docs/superpowers/ export-ignore
scripts/dev/shadow-acceptance-case.py export-ignore
schemas/acceptance-case-manifest.v1.json export-ignore
# Docs authoring surface: claudux preferences and the local VitePress preview
# scaffold. The shipped product is the Markdown under docs/, never the Node
# tooling that renders it, so none of this belongs in the release artifact.
claudux.json export-ignore
claudux.md export-ignore
docs/.gitignore export-ignore
docs/.vitepress/ export-ignore
docs/package.json export-ignore
docs/package-lock.json export-ignore
docs/postcss.config.js export-ignore
docs/vite.config.js export-ignore
