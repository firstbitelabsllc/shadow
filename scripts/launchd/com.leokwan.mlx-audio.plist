<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.leokwan.mlx-audio</string>

  <!--
    LaunchAgent for the local Voxtral 4B-TTS server consumed by
    vidux-browse's Read-aloud add-on. See:
      ~/Development/vidux/projects/voxtral-reader-addon/PLAN.md (M4)
      ~/Development/vidux/projects/voxtral-reader-addon/evidence/2026-05-01-architecture.md (§D4)

    Install (per Mac):
      cp ~/Development/vidux/scripts/launchd/com.leokwan.mlx-audio.plist \
         ~/Library/LaunchAgents/com.leokwan.mlx-audio.plist
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.leokwan.mlx-audio.plist

    Uninstall:
      launchctl bootout gui/$(id -u)/com.leokwan.mlx-audio
      rm ~/Library/LaunchAgents/com.leokwan.mlx-audio.plist
  -->

  <key>ProgramArguments</key>
  <array>
    <string>/Users/leokwan/.local/bin/mlx_audio.server</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8000</string>
    <string>--allowed-origins</string>
    <string>http://localhost:7191</string>
    <string>http://127.0.0.1:7191</string>
    <string>--log-dir</string>
    <string>/Users/leokwan/Library/Logs</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- Don't thrash on crash-on-startup loops (e.g., OOM during model load). -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>WorkingDirectory</key>
  <string>/Users/leokwan</string>

  <key>StandardOutPath</key>
  <string>/Users/leokwan/Library/Logs/mlx-audio.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/leokwan/Library/Logs/mlx-audio.stderr.log</string>

  <!-- Background priority — model inference is CPU/GPU heavy and we don't want
       it to preempt Leo's foreground work (Xcode, Final Cut, the browser itself). -->
  <key>ProcessType</key>
  <string>Background</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/leokwan/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/leokwan</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
    <key>LC_ALL</key>
    <string>en_US.UTF-8</string>
    <!-- HF cache is the default ~/.cache/huggingface but be explicit so a future
         per-Mac override (e.g., point Studio at an external SSD) is one line. -->
    <key>HF_HOME</key>
    <string>/Users/leokwan/.cache/huggingface</string>
  </dict>
</dict>
</plist>
