{
  "name": "@firstbitelabs/shadow",
  "version": "4.0.0",
  "description": "Chief-of-staff briefing, local role routing, and bounded native-host execution for AI coding work.",
  "private": false,
  "bin": {
    "shadow": "bin/shadow"
  },
  "files": [
    ".claude-plugin/",
    ".claude/settings.json",
    "assets/*.png",
    "assets/*.svg",
    "bin/*",
    "browser/outcome_source.py",
    "browser/chief_of_staff.py",
    "browser/decision_mode.py",
    "browser/server.py",
    "browser/static/**/*",
    "docs/**/*.md",
    "docs/.vitepress/config.ts",
    "examples/**/*.json",
    "examples/**/*.md",
    "scripts/*.py",
    "scripts/*.sh",
    "schemas/**/*.json",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "SKILL.md",
    "AGENT.md",
    "SUPPORT.md",
    "VERSION"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firstbitelabsllc/shadow.git"
  },
  "homepage": "https://github.com/firstbitelabsllc/shadow",
  "bugs": {
    "url": "https://github.com/firstbitelabsllc/shadow/issues"
  },
  "author": "First Bite Labs",
  "license": "MIT",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "test": "npm run test:js && npm run test:py",
    "test:all": "npm run test:js && npm run test:py && npm run test:e2e",
    "test:js": "vitest run",
    "test:js:watch": "vitest",
    "lint:plan": "scripts/shadow-python.sh scripts/shadow-lint.py PLAN.md",
    "test:py": "scripts/shadow-python.sh -m unittest discover -s tests -p 'test_*.py' && npm run lint:plan",
    "public-ready:grep": "scripts/shadow-python.sh scripts/shadow-public-ready-grep-gate.py --tracked-only --metadata",
    "verify": "npm test && npm run public-ready:grep",
    "prepublishOnly": "npm run verify && npm run release:verify",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "release:verify": "scripts/shadow-python.sh scripts/shadow-release-package.py",
    "release:verify:dev": "scripts/shadow-python.sh scripts/shadow-release-package.py --allow-dirty",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "happy-dom": "^20.10.6",
    "vitepress": "1.6.4",
    "vitest": "^4.1.10",
    "vue": "3.5.13"
  },
  "overrides": {
    "postcss": "8.5.25",
    "vitepress": {
      "vite": "6.4.3"
    }
  }
}
