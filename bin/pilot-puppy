#!/usr/bin/env bash
# pilot-puppy — top-level CLI dispatcher.
#
# Routes subcommands to existing helpers in scripts/ and bin/.
#
set -euo pipefail

PILOT_PUPPY_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${PILOT_PUPPY_SOURCE}" ]]; do
  PILOT_PUPPY_SOURCE_DIR="$(cd -P "$(dirname "${PILOT_PUPPY_SOURCE}")" && pwd)"
  PILOT_PUPPY_SOURCE="$(readlink "${PILOT_PUPPY_SOURCE}")"
  [[ "${PILOT_PUPPY_SOURCE}" != /* ]] && PILOT_PUPPY_SOURCE="${PILOT_PUPPY_SOURCE_DIR}/${PILOT_PUPPY_SOURCE}"
done
PILOT_PUPPY_BIN_DIR="$(cd -P "$(dirname "${PILOT_PUPPY_SOURCE}")" && pwd)"
PILOT_PUPPY_ROOT="${PILOT_PUPPY_ROOT:-$(cd "${PILOT_PUPPY_BIN_DIR}/.." && pwd)}"

print_top_help() {
  cat <<EOF
pilot-puppy — local plan, proof, and resume tools for AI coding work

usage: pilot-puppy <command> [args...]

commands:
  init --here        Create one repository-owned PLAN.md
  browse [args]     Launch the plan browser at :7191
  status [args]     Print plan status across operational PLAN.md files
  checkpoint [args] Update a PLAN.md and write one bounded local receipt
  roster [args]     Create, show, or locally prefer a generic work-role roster
  seat [args]       Configure one private selector for an already-declared native slot
  route [args]      Explain one local role and native-host choice without launching it
  drive [args]      Prepare or explicitly start a small local work batch
  host [args]       Probe or run one sealed task through a native coding host
  doctor            Install/readiness doctor for local CLI setup
  help [<cmd>]      Show this help, or help for a specific subcommand

options:
  --version, -v     Print pilot-puppy version
  --help, -h        Show this help

See README.md and docs/ for the current CLI roadmap and implemented helpers.
EOF
}

print_subcommand_help() {
  local cmd="${1:-}"
  case "${cmd}" in
    browse)
      cat <<EOF
pilot-puppy browse — launch the plan browser at :7191.

usage: pilot-puppy browse [--no-open] [--port N] \\
  [--host HOST] [--root PATH] [--help|-h]

Runs one foreground loopback server. Stop it with Ctrl-C.

flags:
  --no-open             Do not open the browser automatically.
  --port N             Bind a specific port (default: 7191).
  --host HOST          Server bind host (default: 127.0.0.1).
  --root PATH          Scan root for PLAN.md files (default: ~/Development).
The server is loopback-only. A/B/C choices are saved atomically inside the
selected Git project's .pilot-puppy/evidence directory.
EOF
      ;;
    status)
      cat <<EOF
pilot-puppy status — print chief-of-staff briefs from PLAN.md files.

usage: pilot-puppy status [--root <path>] [--all] [--json]

The current directory is the default scan root. Default output hides finished
Outcomes; --all includes them. Each active brief reports Outcome, Now,
recommendation, and any A/B/C choice. No external or hidden state is read.
EOF
      ;;
    init)
      cat <<EOF
pilot-puppy init — bootstrap a new plan.

usage: pilot-puppy init --here

Creates PLAN.md at the current Git project root. The plan includes one typed
Outcome, one A/B/C choice, one work row, and one progress row. Existing plans
are never overwritten; there is no global plan store.

exit codes:
  0   plan created
  1   target PLAN.md already exists
  2   invalid usage or not at a Git project root
EOF
      ;;
    checkpoint)
      cat <<EOF
pilot-puppy checkpoint — update a plan and write one bounded local receipt.

usage: pilot-puppy checkpoint <plan-path> <task> <summary> \\
  --proof <text> \\
  [--blocker <text>] [--status done|done_with_concerns|blocked] \\
  [--outcome useful|busy|blocked_clarified] [--commit]

The repository plan remains authority. The receipt is bounded evidence, never
a queue or authorization to push, merge, deploy, spend, or contact anyone.
Completion requires explicit proof text. Changes remain uncommitted unless
--commit is supplied.
EOF
      ;;
    roster)
      cat <<EOF
pilot-puppy roster — create, show, or prefer local, generic work roles.

usage: pilot-puppy roster init [--file PATH] [--json]
       pilot-puppy roster show [--file PATH] [--json]
       pilot-puppy roster prefer --role ROLE --host codex|claude-code|cursor|manual [--file PATH] [--json]

Creates or reads a local roster with these roles: lead, planner, dev, debug,
review, and hard-dev. It is a local setup and display tool only. It does not
choose a provider or model, inspect accounts or quota, start a host, dispatch
work, or write project evidence.

Use --file only for a deliberately chosen local roster location. The default
roster stays outside a project, and it is never read by browse, status, or
receipts. prefer moves one already-declared role/host slot to first within
that role; it never creates a slot, launches work, or adds provider data. Use
route to make one foreground, explainable selection from its generic role slots.
EOF
      ;;
    seat)
      cat <<EOF
pilot-puppy seat — configure an owner-local native selector for one generic slot.

usage: pilot-puppy seat init [--file PATH] [--json]
       pilot-puppy seat show [--file PATH] [--roster-file PATH] [--json]
       pilot-puppy seat set --slot SLOT (--model MODEL | --profile PROFILE) \\
         [--file PATH] [--roster-file PATH] [--json]

This is a private local overlay for a slot that already exists in the generic
roster. It may attach a model selector to Codex, Claude Code, or Cursor, or a
Codex profile selector. It cannot add slots, change roles/hosts/priorities, or
configure a manual role. It never discovers models, accounts, quota, prices,
credentials, or provider payloads.

The overlay is intentionally absent from browse, status, PLAN.md, route packets,
and project receipts. It affects a native invocation only when an operator passes
--use-seat to pilot-puppy host run alongside a ready sealed --route-file. A
missing or invalid mapping blocks before the native process starts.
EOF
      ;;
    route)
      cat <<EOF
pilot-puppy route — choose one declared local role without starting a host.

usage: pilot-puppy route --repo PATH --task-id ID --task-file PATH \\
  (--task-kind plan|hard-dev|dev|debug|review|lead | --role ROLE) \\
  [--host codex|claude-code|cursor|manual] [--roster-file PATH] \\
  [--availability probe|assume] [--out .pilot-puppy/evidence/route.json] [--json]

The task kind maps to one generic role: plan→planner, hard-dev→hard-dev,
dev→dev, debug→debug, review→review, and lead→lead. Pilot Puppy prints the
selected native-host surface, same-role alternatives, and escalation point. It
does not start a host, inspect account/authentication/quota data, retry, queue,
or silently substitute a host. A written route packet can be passed explicitly
to pilot-puppy host run with --route-file for fail-closed binding.
EOF
      ;;
    drive)
      cat <<EOF
pilot-puppy drive — prepare and explicitly start a small local work batch.

usage: pilot-puppy drive prepare --repo PATH [--plan PLAN.md] [--roster-file PATH] [--availability probe|assume] [--json]
       pilot-puppy drive launch --repo PATH --session SESSION [--plan PLAN.md] [--roster-file PATH] [--timeout-seconds N] [--json]
       pilot-puppy drive accept --repo PATH --session SESSION [--plan PLAN.md] [--timeout-seconds N] [--json]

Drive Packets live in the project's existing PLAN.md. prepare reads that plan,
chooses up to three ready pieces of work only when their allowed paths and
chosen native hosts do not overlap, and writes bounded local preparation files.
It starts nothing.

launch is the explicit foreground action. It rechecks the frozen plan and Git
revision, creates one clean worktree per prepared lane, runs the chosen native
host, rechecks scope, runs the plan's named local check, and commits a green
change on its kept review branch.

accept is a separate explicit local action for a fully checked session. It
reproduces each named check in a separate clean lead checkout, then creates one
local Git merge commit in this project. It does not push, open a PR, deploy,
publish, spend money, delete a worktree, or silently retry/reroute.
EOF
      ;;
    host)
      cat <<EOF
pilot-puppy host — use one native Codex, Claude Code, or Cursor process.

usage: pilot-puppy host probe --host codex|claude-code|cursor [--json]
       pilot-puppy host run --host HOST --repo PATH --task-file PATH \\
         --task-id ID --allowed-path PATH [--allowed-path PATH ...] \\
         [--route-file .pilot-puppy/evidence/route.json] [--roster-file PATH] \\
         [--use-seat [--seat-file PATH]] \\
         [--out PATH] [--timeout-seconds N] [--json]

The task file is frozen, the Git worktree must be clean, allowed paths are
exact, and a successful host must emit one pilot-puppy.host-receipt.v1 object
with passing tests. The result remains unreviewed until the lead reproduces it.
When --route-file is supplied, the frozen task, local roster revision, and
selected host must still match before any host process is launched.
--use-seat is opt-in and requires --route-file. It adds one private local model
or Codex profile selector only to the exact already-routed native slot. The
selector is never emitted to browse, status, route packets, plans, or attempts.
EOF
      ;;
    doctor)
      cat <<EOF
pilot-puppy doctor — read-only installation and native-host doctor.

usage: pilot-puppy doctor [--json] [--help|-h]

Checks product identity, Python, Git, PATH installation, native Codex/Claude
Code/Cursor availability, and those three skill mounts. It is read-only and
never fetches, repairs, authenticates, or runs the test suite. Missing optional
hosts or mounts warn; contradictory product identity or mount custody fails.

Each check prints [PASS], [WARN], or [FAIL]. --json emits the same bounded
report. Exit 0 when no hard check fails and 1 otherwise.
EOF
      ;;
    help|"")
      print_top_help
      ;;
    *)
      echo "pilot-puppy: unknown command for help: ${cmd}" >&2
      print_top_help >&2
      return 2
      ;;
  esac
}

print_version() {
  # VERSION file may contain trailing notes; the first non-empty,
  # non-comment line is the version string.
  awk 'NF && $1 !~ /^#/ { print; exit }' "${PILOT_PUPPY_ROOT}/VERSION"
}

# Every subcommand
# below exec's straight into python3/bash/awk against ${PILOT_PUPPY_ROOT}/scripts
# with no preflight, so a missing python3 or a broken/misdirected PILOT_PUPPY_ROOT
# (e.g. an env var pointing at an unrelated or incomplete checkout) leaked a
# raw interpreter error ("bash: exec: python3: not found",
# "python3: can't open file ...", "awk: can't open file ...") instead of a
# pilot-puppy-authored message. require_pilot_puppy_checkout runs once before dispatch
# (help/-h stay exempt -- pure static text, no filesystem access) so every
# subcommand gets the same clear message for the same root cause.
require_pilot_puppy_checkout() {
  if [[ ! -f "${PILOT_PUPPY_ROOT}/VERSION" || ! -d "${PILOT_PUPPY_ROOT}/scripts" ]]; then
    echo "pilot-puppy: PILOT_PUPPY_ROOT does not look like a pilot-puppy checkout: ${PILOT_PUPPY_ROOT}" >&2
    echo "  Expected a VERSION file and a scripts/ directory under it." >&2
    echo "  If PILOT_PUPPY_ROOT is set in your environment, unset it or point it at a real pilot-puppy checkout." >&2
    exit 127
  fi
}

require_python3() {
  local cmd="$1"
  local resolved
  if ! resolved="$(PILOT_PUPPY_PYTHON_COMMAND="${cmd}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-python.sh" --print)"; then
    exit 127
  fi
  PILOT_PUPPY_PYTHON="${resolved}"
  export PILOT_PUPPY_PYTHON
}

main() {
  if [[ $# -eq 0 ]]; then
    print_top_help
    exit 0
  fi

  local cmd="$1"
  shift || true

  if [[ "${cmd}" != "--help" && "${cmd}" != "-h" && "${cmd}" != "help" ]]; then
    require_pilot_puppy_checkout
  fi

  case "${cmd}" in
    --version|-v)
      print_version
      ;;
    --help|-h|help)
      if [[ $# -gt 0 ]]; then
        print_subcommand_help "$1"
      else
        print_top_help
      fi
      ;;
    browse)
      require_python3 "browse"
      export PILOT_PUPPY_ROOT
      exec "${PILOT_PUPPY_ROOT}/bin/pilot-puppy-browse" "$@"
      ;;
    status)
      require_python3 "status"
      exec "${PILOT_PUPPY_PYTHON}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-status.py" "$@"
      ;;
    init)
      require_python3 "init"
      exec "${PILOT_PUPPY_PYTHON}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-init.py" "$@"
      ;;
    checkpoint)
      require_python3 "checkpoint"
      export PILOT_PUPPY_ROOT
      exec "${PILOT_PUPPY_PYTHON}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-checkpoint.py" "$@"
      ;;
    roster)
      require_python3 "roster"
      exec "${PILOT_PUPPY_PYTHON}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-roster.py" "$@"
      ;;
    seat)
      require_python3 "seat"
      exec "${PILOT_PUPPY_PYTHON}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-seat.py" "$@"
      ;;
    route)
      require_python3 "route"
      exec "${PILOT_PUPPY_PYTHON}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-route.py" "$@"
      ;;
    drive)
      require_python3 "drive"
      exec "${PILOT_PUPPY_PYTHON}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-drive.py" "$@"
      ;;
    host)
      require_python3 "host"
      exec "${PILOT_PUPPY_PYTHON}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-host.py" "$@"
      ;;
    doctor)
      require_python3 "doctor"
      export PILOT_PUPPY_ROOT
      export PILOT_PUPPY_DOCTOR_EXPECTED_CLI="${PILOT_PUPPY_ROOT}/bin/pilot-puppy"
      exec "${PILOT_PUPPY_PYTHON}" "${PILOT_PUPPY_ROOT}/scripts/pilot-puppy-doctor.py" "$@"
      ;;
    *)
      echo "pilot-puppy: unknown command: ${cmd}" >&2
      echo >&2
      print_top_help >&2
      exit 2
      ;;
  esac
}

main "$@"
