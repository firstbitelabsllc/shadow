#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SOURCE}" ]]; do
  SOURCE_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
  SOURCE="$(readlink "${SOURCE}")"
  [[ "${SOURCE}" != /* ]] && SOURCE="${SOURCE_DIR}/${SOURCE}"
done
BIN_DIR="$(cd -P "$(dirname "${SOURCE}")" && pwd)"
ROOT="${PILOT_PUPPY_ROOT:-$(cd "${BIN_DIR}/.." && pwd)}"

exec env PILOT_PUPPY_PYTHON_COMMAND=browse "${ROOT}/scripts/pilot-puppy-python.sh" "${ROOT}/browser/server.py" "$@"
