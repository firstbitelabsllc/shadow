#!/usr/bin/env bash
# vidux — top-level CLI dispatcher.
#
# Routes subcommands to existing helpers in scripts/ and bin/. Stubs
# unimplemented subcommands with a pointer to the PLAN.md row that will
# land them.
#
set -euo pipefail

VIDUX_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${VIDUX_SOURCE}" ]]; do
  VIDUX_SOURCE_DIR="$(cd -P "$(dirname "${VIDUX_SOURCE}")" && pwd)"
  VIDUX_SOURCE="$(readlink "${VIDUX_SOURCE}")"
  [[ "${VIDUX_SOURCE}" != /* ]] && VIDUX_SOURCE="${VIDUX_SOURCE_DIR}/${VIDUX_SOURCE}"
done
VIDUX_BIN_DIR="$(cd -P "$(dirname "${VIDUX_SOURCE}")" && pwd)"
VIDUX_ROOT="${VIDUX_ROOT:-$(cd "${VIDUX_BIN_DIR}/.." && pwd)}"

print_top_help() {
  cat <<EOF
vidux — plan-first control plane for AI agents

usage: vidux <command> [args...]

commands:
  dev [--bg]        Start the local dev browser (foreground; auto-restart)
  browse [args]     Launch the plan browser at :7191
  status [args]     Print plan status across operational PLAN.md files
  init <slug>       Bootstrap a new plan's PLAN.md from template
  drift <PLAN.md>   Record planned-vs-actual drift and optional subplan updates
  config <cmd>      Inspect, validate, or initialize local vidux.config.json
  signpost <cmd>    Emit or summarize local Vidux feature signposts
  http-smoke <url>  Classify local HTTP monitor budget responses
  doctor            Install/readiness doctor for local CLI setup
  build             Run docs:build + contract tests as release gate
  release           Bump VERSION + cut CHANGELOG + plan/ledger-gated tag + push
  completion <shell>  Emit completion script for bash|zsh|fish
  help [<cmd>]      Show this help, or help for a specific subcommand

options:
  --version, -v     Print vidux version
  --help, -h        Show this help

See README.md and docs/ for the current CLI roadmap and implemented helpers.
EOF
}

print_subcommand_help() {
  local cmd="${1:-}"
  case "${cmd}" in
    dev)
      cat <<EOF
vidux dev — start the local dev browser with auto-restart on file changes.

usage: vidux dev [--bg] [--help|-h]

By default, runs bin/vidux-browse in the foreground (ctrl-c stops it).
Watches browser/ via stdlib os.stat polling — on any change to a file
under browser/, SIGTERMs the running server and restarts it. Mental
model: same as 'npm run dev' for a Node app.

flags:
  --bg              Background mode (delegate to bin/vidux-browse default
                    background launcher; survives terminal close).
  --help, -h        Show this help.

environment:
  VIDUX_DEV_POLL_INTERVAL   Poll interval in seconds (default 0.5)
EOF
      ;;
    browse)
      cat <<EOF
vidux browse — launch the plan browser at :7191.

usage: vidux browse [--no-open] [--foreground|-f] [--port N] [--host HOST] \\
  [--root PATH] [--open-host HOST] [--comments-path PATH] [--help|-h]

Proxies to bin/vidux-browse. The launcher refuses to reuse an existing port
listener unless /api/health matches the requested repo root, scan root, port,
and browser/server.py file mtime fingerprint.

flags:
  --no-open             Start/reuse the server without opening a browser.
  --foreground, -f      Run in the foreground and stream server logs.
  --port N             Bind/reuse a specific port (default: 7191).
  --host HOST          Server bind host (default: 127.0.0.1).
  --root PATH          Scan root for PLAN.md files (default: ~/Development).
  --open-host HOST     Browser URL host (default: 127.0.0.1).
  --comments-path PATH Comments JSONL path.
EOF
      ;;
    status)
      cat <<EOF
vidux status — print plan status across operational PLAN.md files.

usage: vidux status [--root <path>] [--focus <repo>...] [--all] [--json]

Runs scripts/vidux-status.py. Default output hides empty and shipped plans;
--all includes tracked rows, including shipped rows, and --json prints the
same counts without the rendered board.
EOF
      ;;
    init)
      cat <<EOF
vidux init — bootstrap a new plan.

usage: vidux init <slug>

Creates projects/<slug>/PLAN.md from the canonical template. The slug
must be lowercase letters, digits, and hyphens (matching ^[a-z0-9-]+\$).
Refuses to overwrite an existing PLAN.md.

The template ships with the six canonical sections:
  Purpose · Evidence · Constraints · Tasks · Decision Log · Progress

exit codes:
  0   plan created
  1   target PLAN.md already exists
  2   invalid usage (no slug, bad slug, unknown flag)
EOF
      ;;
    drift)
      cat <<EOF
vidux drift — record planned-vs-actual drift in a PLAN.md.

usage: vidux drift <PLAN.md> --task <id> --planned <text> --actual <text> \\
  --why <text> --plan-update <text> --next <text> [--block-task <id>] \\
  [--add-task <task>] [--subplan <path>] [--prevention <text>] \\
  [--cache <path>] [--telemetry <path>]

usage: vidux drift suggest <PLAN.md> [--cache <path>] [--limit N]

Writes a structured ## Drift Log entry, appends a Progress note, and can
explicitly block a stale task, add follow-up tasks, or mirror the drift into
named subplans. The helper never mutates unrelated tasks silently. Cache rows
and signposts are local JSONL helpers for future-plan feedback and profiling.
EOF
      ;;
    config)
      cat <<EOF
vidux config — inspect, validate, or initialize local user config.

usage:
  vidux config path [--json] [--config <path>]
  vidux config check [--json] [--strict] [--config <path>]
  vidux config show [--json] [--config <path>]
  vidux config init [--path <path>] [--source <path>] [--force]

The live vidux.config.json is local-only and gitignored. When no live config
exists, Vidux falls back to the checked-in vidux.config.example.json for shape
validation and docs proof. Use --strict when a real local config must exist.

commands:
  path             Print the selected config path and source.
  check            Validate config shape, path expansion, inbox sources, and
                   obvious inline-secret hazards without dumping secrets.
  show             Print the same redacted summary as check.
  init             Copy vidux.config.example.json to vidux.config.json.
EOF
      ;;
    signpost)
      cat <<EOF
vidux signpost — emit or summarize local feature signposts.

usage:
  vidux signpost emit --feature <name> --action <name> [--status ok] [--meta k=v]
  vidux signpost summary [--json]
  vidux signpost trace [--run-id <id>] [--json]
  vidux signpost lifecycle-smoke [--run-id <id>] [--json]
  vidux signpost spawned-subagent-smoke [--run-id <id>] [--json]

Signposts are local JSONL profiler events for helper calls, not product
analytics. Use them to verify that vidux features ran, how often, and with
what status/duration. Trace mode prints ordered events for hook and spawned
subagent call-stack proof. Lifecycle smoke emits a standard Codex parent,
Claude subagent, Cursor verify, Codex afterTask trace into one run id.
Spawned-subagent smoke simulates inherited Codex parent env plus Claude and
Cursor worker env attribution without launching external runtimes.
EOF
      ;;
    http-smoke)
      cat <<EOF
vidux http-smoke — observe-only HTTP monitor budget smoke.

usage:
  vidux http-smoke [--json] [--timeout <seconds>] [--max-sample-bytes <n>] <url>...
  vidux http-smoke --url <url> [--url <url>] [--json]

Runs scripts/vidux-http-smoke.py. The helper classifies local monitor probes
without dumping full response bodies:
  pass           response completed inside the budget
  warn_partial   response streamed bytes before the timeout budget expired
  fail_budget    zero response bytes arrived before the timeout budget expired

JSON top-level ok follows hard-fail exit status. strict_ok is false when any
warning is present, and warning_only identifies warning-only exit 0 runs.
--timeout must be greater than 0. --max-sample-bytes must be 0 or greater.

This is read-only. It does not repair routes, start services, execute local-CI
lanes, or mutate app repos.
EOF
      ;;
    doctor)
      cat <<EOF
vidux doctor — install/readiness doctor for local CLI setup.

usage: vidux doctor [--help|-h]

Runs 7 checks (python3 >= 3.10, gh auth status, ~/.config/vidux/*.token
chmod 600, ~/Development exists, no stale browser pidfile, vidux config,
npm test). This can be slow when it runs the full npm test gate; set
VIDUX_DOCTOR_SKIP_NPM_TEST=1 for fast local loops that already run tests.

Use scripts/vidux-doctor.sh --json for hook-safe runtime checks across plans,
worktrees, automations, browsers, and Codex state. That runtime doctor is the
right beforeTask/pre-hook probe; vidux doctor is the terminal setup/readiness
probe.

Each check prints [PASS] or [FAIL] with reason. Exit 0 if all pass, 1 if any
check fails, and 2 for invalid usage. Footer prints an N/TOTAL summary.
EOF
      ;;
    build)
      cat <<EOF
vidux build — sanity gate before release.

usage: vidux build [--help|-h]

Runs two steps in order; aborts on first failure:
  1. npm run docs:build   — vitepress build of docs/
  2. npm test             — python contract test suite

Exits 0 only when both pass. On failure, prints which step failed
and the tail of its captured output.
EOF
      ;;
    release)
      cat <<EOF
vidux release — bump VERSION, cut CHANGELOG, then plan/ledger-gated tag + push.

usage: vidux release [--apply] [--bump <major|minor|patch>] [--allow-dirty] \\
  [--plan-path <PLAN.md>] [--task-id <task-id>] [--proof <text>] [--resume <text>]

Dry-run by default — prints every mutation it would perform but touches
nothing. Pass --apply to actually cut the release.

In --apply mode, release publish requires --plan-path, --task-id, --proof, and --resume
so the owning plan task row and publish ledger row are updated before the tag push.

flags:
  --apply           Actually run. Without this, dry-run is the default.
  --bump <part>     Which semver part to bump: major | minor | patch.
                    Defaults to patch.
  --allow-dirty     Skip the clean-working-tree precheck.
  --plan-path <p>   Owning PLAN.md. Required with --apply.
  --task-id <id>    Existing task row in the owning PLAN.md. Required with --apply.
  --proof <text>    Command/artifact proof. Required with --apply.
  --resume <text>   Next-agent resume point. Required with --apply.
  --handoff-status <s>
                    Final handoff status for publish ledger rows.
  --help, -h        Show this help.

Refuses to run on any branch other than 'main', or when the working tree
is dirty (unless --allow-dirty). Run 'vidux release --help' for the full
release helper flag list, including file/claim and ledger-emitter options.
EOF
      ;;
    completion)
      cat <<EOF
vidux completion — emit a shell completion script to stdout.

usage: vidux completion <bash|zsh|fish>

Emits a self-contained completion script for the requested shell.
Pipe into your shell's rc file to enable TAB completion for vidux
subcommands and flags.

install (bash):
  echo 'source <(vidux completion bash)' >> ~/.bashrc

install (zsh):
  echo 'source <(vidux completion zsh)' >> ~/.zshrc

install (fish):
  vidux completion fish > ~/.config/fish/completions/vidux.fish

flags:
  --help, -h        Show this help.
EOF
      ;;
    help|"")
      print_top_help
      ;;
    *)
      echo "vidux: unknown command for help: ${cmd}" >&2
      print_top_help >&2
      return 2
      ;;
  esac
}

print_version() {
  # VERSION file may contain trailing notes; the first non-empty,
  # non-comment line is the version string.
  awk 'NF && $1 !~ /^#/ { print; exit }' "${VIDUX_ROOT}/VERSION"
}

stub_exit() {
  local cmd="$1"
  local row="$2"
  echo "vidux ${cmd}: not implemented yet — pending PLAN.md row ${row}" >&2
  echo "see README.md and docs/ for the current CLI roadmap" >&2
  exit 1
}

# Round-3 readiness panel finding (error-messages-ux lens): every subcommand
# below exec's straight into python3/bash/awk against ${VIDUX_ROOT}/scripts
# with no preflight, so a missing python3 or a broken/misdirected VIDUX_ROOT
# (e.g. an env var pointing at an unrelated or incomplete checkout) leaked a
# raw interpreter error ("bash: exec: python3: not found",
# "python3: can't open file ...", "awk: can't open file ...") instead of a
# vidux-authored message. require_vidux_checkout runs once before dispatch
# (help/-h stay exempt -- pure static text, no filesystem access) so every
# subcommand gets the same clear message for the same root cause.
require_vidux_checkout() {
  if [[ ! -f "${VIDUX_ROOT}/VERSION" || ! -d "${VIDUX_ROOT}/scripts" ]]; then
    echo "vidux: VIDUX_ROOT does not look like a vidux checkout: ${VIDUX_ROOT}" >&2
    echo "  Expected a VERSION file and a scripts/ directory under it." >&2
    echo "  If VIDUX_ROOT is set in your environment, unset it or point it at a real vidux checkout." >&2
    exit 127
  fi
}

require_python3() {
  local cmd="$1"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "vidux ${cmd}: python3 not found on PATH." >&2
    echo "  This subcommand requires Python 3.10+. Install it, then re-run." >&2
    echo "  'vidux doctor' runs a full readiness check once python3 is installed." >&2
    exit 127
  fi
}

main() {
  if [[ $# -eq 0 ]]; then
    print_top_help
    exit 0
  fi

  local cmd="$1"
  shift || true

  if [[ "${cmd}" != "--help" && "${cmd}" != "-h" && "${cmd}" != "help" ]]; then
    require_vidux_checkout
  fi

  case "${cmd}" in
    --version|-v)
      print_version
      ;;
    --help|-h|help)
      if [[ $# -gt 0 ]]; then
        print_subcommand_help "$1"
      else
        print_top_help
      fi
      ;;
    dev)
      local dev_bg=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --bg)
            dev_bg=1; shift ;;
          --help|-h)
            print_subcommand_help "dev"; exit 0 ;;
          *)
            echo "vidux dev: unknown flag: $1" >&2
            print_subcommand_help "dev" >&2
            exit 2 ;;
        esac
      done
      if [[ "${dev_bg}" -eq 1 ]]; then
        export VIDUX_ROOT
        exec "${VIDUX_ROOT}/bin/vidux-browse"
      fi
      export VIDUX_ROOT
      require_python3 "dev"
      exec python3 "${VIDUX_ROOT}/scripts/vidux-dev.py"
      ;;
    browse)
      export VIDUX_ROOT
      exec "${VIDUX_ROOT}/bin/vidux-browse" "$@"
      ;;
    status)
      require_python3 "status"
      exec python3 "${VIDUX_ROOT}/scripts/vidux-status.py" "$@"
      ;;
    init)
      export VIDUX_ROOT
      exec bash "${VIDUX_ROOT}/scripts/vidux-init.sh" "$@"
      ;;
    drift)
      require_python3 "drift"
      exec python3 "${VIDUX_ROOT}/scripts/vidux-drift-log.py" "$@"
      ;;
    config)
      require_python3 "config"
      exec python3 "${VIDUX_ROOT}/scripts/vidux-config.py" "$@"
      ;;
    signpost)
      require_python3 "signpost"
      exec python3 "${VIDUX_ROOT}/scripts/vidux_signpost.py" "$@"
      ;;
    http-smoke)
      require_python3 "http-smoke"
      exec python3 "${VIDUX_ROOT}/scripts/vidux-http-smoke.py" "$@"
      ;;
    doctor)
      export VIDUX_ROOT
      exec bash "${VIDUX_ROOT}/scripts/vidux-doctor-cli.sh" "$@"
      ;;
    build)
      exec bash "${VIDUX_ROOT}/scripts/vidux-build.sh" "$@"
      ;;
    release)
      exec bash "${VIDUX_ROOT}/scripts/vidux-release.sh" "$@"
      ;;
    completion)
      if [[ $# -eq 0 ]]; then
        echo "vidux completion: missing shell argument" >&2
        print_subcommand_help "completion" >&2
        exit 2
      fi
      case "$1" in
        --help|-h)
          print_subcommand_help "completion"; exit 0 ;;
      esac
      exec "${VIDUX_ROOT}/scripts/vidux-completion.sh" "$@"
      ;;
    *)
      echo "vidux: unknown command: ${cmd}" >&2
      echo >&2
      print_top_help >&2
      exit 2
      ;;
  esac
}

main "$@"
