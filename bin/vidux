#!/usr/bin/env bash
# vidux — top-level CLI dispatcher.
#
# Routes subcommands to existing helpers in scripts/ and bin/. Stubs
# unimplemented subcommands with a pointer to the PLAN.md row that will
# land them.
#
# Implements PLAN.md row T-1 of projects/vidux-oss-niceties.
set -euo pipefail

VIDUX_ROOT="${VIDUX_ROOT:-$HOME/Development/vidux}"

print_top_help() {
  cat <<EOF
vidux — plan-first expedition orchestration for AI agents

usage: vidux <command> [args...]

commands:
  dev [--bg]        Start the local dev browser (foreground; auto-restart)
  browse [args]     Launch the plan browser at :7191
  status [args]     Print active-plan status across projects/*/PLAN.md
  init <slug>       Bootstrap a new plan's PLAN.md from template
  doctor            Diagnose local toolchain + auth                     [stub: T-4]
  build             Run docs:build + contract tests as release gate
  release           Bump VERSION, tag, push                             [stub: T-15]
  help [<cmd>]      Show this help, or help for a specific subcommand

options:
  --version, -v     Print vidux version
  --help, -h        Show this help

See projects/vidux-oss-niceties/PLAN.md for the roadmap of unimplemented
subcommands.
EOF
}

print_subcommand_help() {
  local cmd="${1:-}"
  case "${cmd}" in
    dev)
      cat <<EOF
vidux dev — start the local dev browser with auto-restart on file changes.

usage: vidux dev [--bg] [--help|-h]

By default, runs bin/vidux-browse in the foreground (ctrl-c stops it).
Watches browser/ via stdlib os.stat polling — on any change to a file
under browser/, SIGTERMs the running server and restarts it. Mental
model: same as 'npm run dev' for a Node app.

flags:
  --bg              Background mode (delegate to bin/vidux-browse default
                    background launcher; survives terminal close).
  --help, -h        Show this help.

environment:
  VIDUX_DEV_POLL_INTERVAL   Poll interval in seconds (default 0.5)
EOF
      ;;
    browse)
      cat <<EOF
vidux browse — launch the plan browser at :7191.

usage: vidux browse [--no-open] [--foreground|-f] [--help|-h]

Proxies all arguments to bin/vidux-browse. See 'vidux browse --help'
for the full flag list.
EOF
      ;;
    status)
      cat <<EOF
vidux status — print active-plan status.

usage: vidux status [args...]

Runs scripts/vidux-status.py. All arguments are passed through.
EOF
      ;;
    init)
      cat <<EOF
vidux init — bootstrap a new plan.

usage: vidux init <slug>

Creates projects/<slug>/PLAN.md from the canonical template. The slug
must be lowercase letters, digits, and hyphens (matching ^[a-z0-9-]+\$).
Refuses to overwrite an existing PLAN.md.

The template ships with the six canonical sections:
  Purpose · Evidence · Constraints · Tasks · Decision Log · Progress

exit codes:
  0   plan created
  1   target PLAN.md already exists
  2   invalid usage (no slug, bad slug, unknown flag)
EOF
      ;;
    doctor)
      cat <<EOF
vidux doctor — diagnose local toolchain + auth.

usage: vidux doctor

status: STUB — see projects/vidux-oss-niceties/PLAN.md row T-4.
       Will check python3 >= 3.10, gh auth, token chmod 600,
       stale pidfiles, and contract-test suite pass.
EOF
      ;;
    build)
      cat <<EOF
vidux build — sanity gate before release.

usage: vidux build [--help|-h]

Runs two steps in order; aborts on first failure:
  1. npm run docs:build   — vitepress build of docs/
  2. npm test             — python contract test suite

Exits 0 only when both pass. On failure, prints which step failed
and the tail of its captured output.
EOF
      ;;
    release)
      cat <<EOF
vidux release — bump VERSION, tag, push.

usage: vidux release

status: STUB — see projects/vidux-oss-niceties/PLAN.md row T-15.
       Will bump VERSION, append CHANGELOG from [Unreleased], tag,
       and push. Dry-run by default.
EOF
      ;;
    help|"")
      print_top_help
      ;;
    *)
      echo "vidux: unknown command for help: ${cmd}" >&2
      print_top_help >&2
      return 2
      ;;
  esac
}

print_version() {
  # VERSION file may contain trailing notes; the first non-empty,
  # non-comment line is the version string.
  awk 'NF && $1 !~ /^#/ { print; exit }' "${VIDUX_ROOT}/VERSION"
}

stub_exit() {
  local cmd="$1"
  local row="$2"
  echo "vidux ${cmd}: not implemented yet — pending PLAN.md row ${row}" >&2
  echo "see projects/vidux-oss-niceties/PLAN.md row ${row}" >&2
  exit 1
}

main() {
  if [[ $# -eq 0 ]]; then
    print_top_help
    exit 0
  fi

  local cmd="$1"
  shift || true

  case "${cmd}" in
    --version|-v)
      print_version
      ;;
    --help|-h|help)
      if [[ $# -gt 0 ]]; then
        print_subcommand_help "$1"
      else
        print_top_help
      fi
      ;;
    dev)
      local dev_bg=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --bg)
            dev_bg=1; shift ;;
          --help|-h)
            print_subcommand_help "dev"; exit 0 ;;
          *)
            echo "vidux dev: unknown flag: $1" >&2
            print_subcommand_help "dev" >&2
            exit 2 ;;
        esac
      done
      if [[ "${dev_bg}" -eq 1 ]]; then
        exec "${VIDUX_ROOT}/bin/vidux-browse"
      fi
      exec python3 "${VIDUX_ROOT}/scripts/vidux-dev.py"
      ;;
    browse)
      exec "${VIDUX_ROOT}/bin/vidux-browse" "$@"
      ;;
    status)
      exec python3 "${VIDUX_ROOT}/scripts/vidux-status.py" "$@"
      ;;
    init)
      exec bash "${VIDUX_ROOT}/scripts/vidux-init.sh" "$@"
      ;;
    doctor)
      stub_exit "doctor" "T-4"
      ;;
    build)
      exec bash "${VIDUX_ROOT}/scripts/vidux-build.sh" "$@"
      ;;
    release)
      stub_exit "release" "T-15"
      ;;
    *)
      echo "vidux: unknown command: ${cmd}" >&2
      echo >&2
      print_top_help >&2
      exit 2
      ;;
  esac
}

main "$@"
