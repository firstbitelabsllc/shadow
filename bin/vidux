#!/usr/bin/env bash
# vidux — top-level CLI dispatcher.
#
# Routes subcommands to existing helpers in scripts/ and bin/. Stubs
# unimplemented subcommands with a pointer to the PLAN.md row that will
# land them.
#
set -euo pipefail

VIDUX_ROOT="${VIDUX_ROOT:-$HOME/Development/vidux}"

print_top_help() {
  cat <<EOF
vidux — plan-first expedition orchestration for AI agents

usage: vidux <command> [args...]

commands:
  dev [--bg]        Start the local dev browser (foreground; auto-restart)
  browse [args]     Launch the plan browser at :7191
  status [args]     Print active-plan status across projects/*/PLAN.md
  init <slug>       Bootstrap a new plan's PLAN.md from template
  drift <PLAN.md>   Record planned-vs-actual drift and optional subplan updates
  doctor            Diagnose local toolchain + auth
  build             Run docs:build + contract tests as release gate
  release           Bump VERSION + cut CHANGELOG + tag + push (dry-run by default)
  completion <shell>  Emit completion script for bash|zsh|fish
  help [<cmd>]      Show this help, or help for a specific subcommand

options:
  --version, -v     Print vidux version
  --help, -h        Show this help

See README.md and docs/ for the current CLI roadmap and implemented helpers.
EOF
}

print_subcommand_help() {
  local cmd="${1:-}"
  case "${cmd}" in
    dev)
      cat <<EOF
vidux dev — start the local dev browser with auto-restart on file changes.

usage: vidux dev [--bg] [--help|-h]

By default, runs bin/vidux-browse in the foreground (ctrl-c stops it).
Watches browser/ via stdlib os.stat polling — on any change to a file
under browser/, SIGTERMs the running server and restarts it. Mental
model: same as 'npm run dev' for a Node app.

flags:
  --bg              Background mode (delegate to bin/vidux-browse default
                    background launcher; survives terminal close).
  --help, -h        Show this help.

environment:
  VIDUX_DEV_POLL_INTERVAL   Poll interval in seconds (default 0.5)
EOF
      ;;
    browse)
      cat <<EOF
vidux browse — launch the plan browser at :7191.

usage: vidux browse [--no-open] [--foreground|-f] [--help|-h]

Proxies all arguments to bin/vidux-browse. See 'vidux browse --help'
for the full flag list.
EOF
      ;;
    status)
      cat <<EOF
vidux status — print active-plan status.

usage: vidux status [args...]

Runs scripts/vidux-status.py. All arguments are passed through.
EOF
      ;;
    init)
      cat <<EOF
vidux init — bootstrap a new plan.

usage: vidux init <slug>

Creates projects/<slug>/PLAN.md from the canonical template. The slug
must be lowercase letters, digits, and hyphens (matching ^[a-z0-9-]+\$).
Refuses to overwrite an existing PLAN.md.

The template ships with the six canonical sections:
  Purpose · Evidence · Constraints · Tasks · Decision Log · Progress

exit codes:
  0   plan created
  1   target PLAN.md already exists
  2   invalid usage (no slug, bad slug, unknown flag)
EOF
      ;;
    drift)
      cat <<EOF
vidux drift — record planned-vs-actual drift in a PLAN.md.

usage: vidux drift <PLAN.md> --task <id> --planned <text> --actual <text> \\
  --why <text> --plan-update <text> --next <text> [--block-task <id>] \\
  [--add-task <task>] [--subplan <path>]

Writes a structured ## Drift Log entry, appends a Progress note, and can
explicitly block a stale task, add follow-up tasks, or mirror the drift into
named subplans. The helper never mutates unrelated tasks silently.
EOF
      ;;
    doctor)
      cat <<EOF
vidux doctor — diagnose local toolchain + auth.

usage: vidux doctor [--help|-h]

Runs 6 checks (python3 >= 3.10, gh auth status, ~/.config/vidux/*.token
chmod 600, ~/Development exists, no stale browser pidfile, npm test).
Each check prints [PASS] or [FAIL] with reason. Exit 0 if
all pass, non-zero on any FAIL. Footer with N/6 summary.
EOF
      ;;
    build)
      cat <<EOF
vidux build — sanity gate before release.

usage: vidux build [--help|-h]

Runs two steps in order; aborts on first failure:
  1. npm run docs:build   — vitepress build of docs/
  2. npm test             — python contract test suite

Exits 0 only when both pass. On failure, prints which step failed
and the tail of its captured output.
EOF
      ;;
    release)
      cat <<EOF
vidux release — bump VERSION, cut CHANGELOG, tag, push.

usage: vidux release [--apply] [--bump <major|minor|patch>] [--allow-dirty]

Dry-run by default — prints every mutation it would perform but touches
nothing. Pass --apply to actually cut the release.

flags:
  --apply           Actually run. Without this, dry-run is the default.
  --bump <part>     Which semver part to bump: major | minor | patch.
                    Defaults to patch.
  --allow-dirty     Skip the clean-working-tree precheck.
  --help, -h        Show this help.

Refuses to run on any branch other than 'main', or when the working tree
is dirty (unless --allow-dirty).
EOF
      ;;
    completion)
      cat <<EOF
vidux completion — emit a shell completion script to stdout.

usage: vidux completion <bash|zsh|fish>

Emits a self-contained completion script for the requested shell.
Pipe into your shell's rc file to enable TAB completion for vidux
subcommands and flags.

install (bash):
  echo 'source <(vidux completion bash)' >> ~/.bashrc

install (zsh):
  echo 'source <(vidux completion zsh)' >> ~/.zshrc

install (fish):
  vidux completion fish > ~/.config/fish/completions/vidux.fish

flags:
  --help, -h        Show this help.
EOF
      ;;
    help|"")
      print_top_help
      ;;
    *)
      echo "vidux: unknown command for help: ${cmd}" >&2
      print_top_help >&2
      return 2
      ;;
  esac
}

print_version() {
  # VERSION file may contain trailing notes; the first non-empty,
  # non-comment line is the version string.
  awk 'NF && $1 !~ /^#/ { print; exit }' "${VIDUX_ROOT}/VERSION"
}

stub_exit() {
  local cmd="$1"
  local row="$2"
  echo "vidux ${cmd}: not implemented yet — pending PLAN.md row ${row}" >&2
  echo "see README.md and docs/ for the current CLI roadmap" >&2
  exit 1
}

main() {
  if [[ $# -eq 0 ]]; then
    print_top_help
    exit 0
  fi

  local cmd="$1"
  shift || true

  case "${cmd}" in
    --version|-v)
      print_version
      ;;
    --help|-h|help)
      if [[ $# -gt 0 ]]; then
        print_subcommand_help "$1"
      else
        print_top_help
      fi
      ;;
    dev)
      local dev_bg=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --bg)
            dev_bg=1; shift ;;
          --help|-h)
            print_subcommand_help "dev"; exit 0 ;;
          *)
            echo "vidux dev: unknown flag: $1" >&2
            print_subcommand_help "dev" >&2
            exit 2 ;;
        esac
      done
      if [[ "${dev_bg}" -eq 1 ]]; then
        exec "${VIDUX_ROOT}/bin/vidux-browse"
      fi
      exec python3 "${VIDUX_ROOT}/scripts/vidux-dev.py"
      ;;
    browse)
      exec "${VIDUX_ROOT}/bin/vidux-browse" "$@"
      ;;
    status)
      exec python3 "${VIDUX_ROOT}/scripts/vidux-status.py" "$@"
      ;;
    init)
      exec bash "${VIDUX_ROOT}/scripts/vidux-init.sh" "$@"
      ;;
    drift)
      exec python3 "${VIDUX_ROOT}/scripts/vidux-drift-log.py" "$@"
      ;;
    doctor)
      exec bash "${VIDUX_ROOT}/scripts/vidux-doctor-cli.sh" "$@"
      ;;
    build)
      exec bash "${VIDUX_ROOT}/scripts/vidux-build.sh" "$@"
      ;;
    release)
      exec bash "${VIDUX_ROOT}/scripts/vidux-release.sh" "$@"
      ;;
    completion)
      if [[ $# -eq 0 ]]; then
        echo "vidux completion: missing shell argument" >&2
        print_subcommand_help "completion" >&2
        exit 2
      fi
      case "$1" in
        --help|-h)
          print_subcommand_help "completion"; exit 0 ;;
      esac
      exec "${VIDUX_ROOT}/scripts/vidux-completion.sh" "$@"
      ;;
    *)
      echo "vidux: unknown command: ${cmd}" >&2
      echo >&2
      print_top_help >&2
      exit 2
      ;;
  esac
}

main "$@"
