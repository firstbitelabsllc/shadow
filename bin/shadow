#!/usr/bin/env bash
# shadow — top-level CLI dispatcher.
#
# Routes subcommands to existing helpers in scripts/ and bin/.
#
set -euo pipefail

SHADOW_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "${SHADOW_SOURCE}" ]]; do
  SHADOW_SOURCE_DIR="$(cd -P "$(dirname "${SHADOW_SOURCE}")" && pwd)"
  SHADOW_SOURCE="$(readlink "${SHADOW_SOURCE}")"
  [[ "${SHADOW_SOURCE}" != /* ]] && SHADOW_SOURCE="${SHADOW_SOURCE_DIR}/${SHADOW_SOURCE}"
done
SHADOW_BIN_DIR="$(cd -P "$(dirname "${SHADOW_SOURCE}")" && pwd)"
SHADOW_ROOT="${SHADOW_ROOT:-$(cd "${SHADOW_BIN_DIR}/.." && pwd)}"

print_top_help() {
  cat <<EOF
shadow — one local computer board coordinating entity plans and proof

usage: shadow <command> [args...]

commands:
  init --here        Create one local PLAN.md below ~/.shadow/plans
  browse [args]     Launch the computer-board browser at :7191
  status [args]     Resume owned claims and rank reachable checkpoints
  lint [plans...]   Check PLAN.md files against the grammar
  config [args]     Explain the optional repository-local declaration
  goal [--install|--remove] [--host HOST]
                    Print, install, or remove the static standing goal
  amp [args]        Resume a packet for a checkpoint already owned by one seat
  throw [args]      Atomically claim a checkpoint, then print its packet
  return [args]     Return a claim after completion, parking, or handback
  priority [args]   Set a registered project's computer-wide priority
  accept [args]     Prove and publish one owned checkpoint, then close its claim
  lifecycle [args]  Compact a hot plan or retire one manifested artifact
  plan [args]       Migrate or roll back one plan tree or bounded project map
  read [args]       Project exact verified rows or receipts from a plan tree
  host [args]       Probe a host or run a claimed task through it
  slots             Report which extension slots are filled
  doctor            Install/readiness doctor for local CLI setup
  help [<cmd>]      Show this help, or help for a specific subcommand

options:
  --version, -v     Print shadow version
  --help, -h        Show this help

See README.md and docs/ for the current CLI roadmap and implemented helpers.
EOF
}

print_subcommand_help() {
  local cmd="${1:-}"
  case "${cmd}" in
    browse)
      cat <<EOF
shadow browse — launch the plan browser at :7191.

usage: shadow browse [--no-open] [--port N] \\
  [--host HOST] [--root PATH] [--help|-h]

Runs one foreground loopback server. Stop it with Ctrl-C.

flags:
  --no-open             Do not open the browser automatically.
  --port N             Bind a specific port (default: 7191).
  --host HOST          Server bind host (default: 127.0.0.1).
  --root PATH          Scan root for PLAN.md files (default: ~/Development).
  --allow-host NAME    Also accept this Host header from a proxy you run on
                       this machine (e.g. tailscale serve). Repeatable. The
                       bind stays loopback-only.
The server is loopback-only. A/B/C choices are saved atomically inside the
selected Git project's .shadow/evidence directory.
EOF
      ;;
    status)
      cat <<EOF
shadow status — read this computer's board and rank entity checkpoints.

usage: shadow status [--root PATH] [--by OWNER] [--in-flight] [--shadowed] [--json]

Always reads this computer's ~/.shadow root board and follows its entity-plan
pointers. --root changes only the bounded import root; it never bypasses the
computer board. For tracked-upstream entities, status also projects authenticated
active remote coordination locks without copying them into the local board.
--in-flight reads local claims and those remote observations.
--shadowed adds safe reasons for suppressed or retired copies.
EOF
      ;;
    init)
      cat <<EOF
shadow init — bootstrap a new plan.

usage: shadow init --here

Creates PLAN.md below ~/.shadow/plans for the current Git project with a typed
Outcome, a full-outcome decision, reviewable work rows, and a progress row.
When this checkout resolves to a public Git remote, the Brief also records one
normalized Origin proof-source identity. Existing plans are never overwritten.
An exact init-generated plan left unregistered by an earlier catchable board
failure is registered on retry without changing the file. One content-addressed
receipt anchored in the private root-board Git journal binds recovery to the
generating repository; it carries no plan, task, claim, or board authority and
is removed after registration completes.
The computer root board is created on the first status, claim, or registration
transaction and stores only a pointer to this local plan, never its checkpoint
text or proof.

exit codes:
  0   plan created, or exact stranded plan registered
  1   existing plan refused, or registration failed
  2   invalid usage or not at a Git project root
EOF
      ;;
    lint)
      cat <<EOF
shadow lint — check PLAN.md files against the grammar.

usage: shadow lint [--repo PATH] <plan-path> [<plan-path>...]

Reads only the named files: no LLM, no network, same text same findings.
Every finding prints as path:line: CHECK [severity] detail. Exit 0 when no
blocking finding exists and 1 otherwise. Warnings never block. A registered
machine-local plan has no source tree of its own; give its source checkout as
\`--repo\` so proof-script operands are checked at that checkout's committed HEAD.
EOF
      ;;
    config)
      cat <<EOF
shadow config — explain the optional repository-local declaration.

usage: shadow config --explain [--repo PATH] [--json]

Reads one shadow.yaml at the Git repository root. The file is declaration
only: it stores no resolved state and never selects a provider, model, account,
or credential. It may name a bounded adversarial lens set; the built-in default
is thermo, ponytail. Lens names are review intent, never runtime roles. A
repository without the file uses the built-in version 1 defaults and remains
fully functional.
EOF
      ;;
    goal)
      cat <<EOF
shadow goal — print the static standing goal for a host's instruction file.

usage: shadow goal [--install|--remove] [--host HOST]

The same text for every person, every host, every day: it names the computer
board and entity-plan authority split, the operating hierarchy, stable-seat
resume, proxy stance, proof tiers, lifecycle, and hard rails. Only the board
pointers and plans move, which is why this text is static.

\`shadow goal --install\` writes it into ~/.claude/CLAUDE.md,
~/.codex/AGENTS.md, and ~/.grok/AGENTS.md inside markers it owns, leaving the
rest of the file byte for byte. Running it again is a no-op; \`--remove\`
takes it back out. An unmarked copy pasted by hand is adopted, never
duplicated. \`shadow doctor\` then reports current / stale / not pasted.

  shadow goal --install
  shadow goal --remove

Cursor is not written: its user rules live in application settings, not a
file, so writing a path here would invent a convention.

Read from docs/reference/host-integration.md so the doc and the command can
never drift; a test fails if the extraction anchor moves.
EOF
      ;;
    amp)
      cat <<EOF
shadow amp — resume a paste-ready packet already claimed by one stable seat.

usage: shadow amp [--repo PATH|--entity ID] --by OWNER
                  [--plan PATH] [--task '~hash'] [--max-chars N]

The block is a POINTER to the durable plan, never a second copy: authority
ref + section, mode, the selected starting row with its proof, the milestone's
optional \`- tools:\` line, person-gated rows, and the standing rails —
within one paste budget (default 4000 chars; optional parts drop from the
bottom to fit, the pointer and resume never drop). Deterministic: no LLM,
no network — same plan and board revision, same block. Executable projection
requires a live claim owned by --by; use shadow throw to claim new work.

exit codes:
  0   block printed (char count on stderr)
  1   no claim to resume: the row is claimed by another seat, not claimed
      by --by, or the owned row is not executable work
  2   no plan found or invalid usage
EOF
      ;;
    throw)
      cat <<EOF
shadow throw — claim a checkpoint before work leaves the active seat.

usage: shadow throw --task '~hash' --by OWNER [--repo PATH|--entity ID]
                    [--adopt-expired]

Quote the id: in zsh an unquoted \`~hash\` is a home-directory expansion and
dies before shadow runs.

A migrated row may preserve one legacy mnemonic such as P9a~formats at the
head of its text. Supplying that exact unique alias resolves it to the row's
canonical ~hash before any claim; amp, accept, proof, and board state continue
to use only the canonical id.

The root board at ~/.shadow is the claim authority. A same-computer transaction
registers the entity-plan pointer and owner under an advisory lock, writes it
atomically, and only then prints the goal block. The local PLAN.md is not
rewritten or copied. When a source-backed product branch tracks a remote branch,
the deterministic remote coordination CAS must also succeed before the packet
prints. With no configured upstream, the claim remains local-only. Claims
return after eight hours by default; status
marks an overdue claim stale so a successor probes proof before adopting,
parking, or closing it.

\`--adopt-expired\` asserts that proof was probed and atomically replaces only
an overdue claim. It never steals a live claim.

Refuses rather than guesses: a row with no proof, unmet needs, an existing
root-board claim, an unknown id, or an entity plan mid-merge.

Use a row for each independently recoverable job. Fan-out lanes that can land
or fail independently get distinct claimed rows.

exit codes:
  0   row claimed locally and block printed
  1   refused; if already claimed, names the owner
  2   no plan found or invalid usage
EOF
      ;;
    return)
      cat <<EOF
shadow return — return one claim to this computer's board.

usage: shadow return --row '~hash' --by OWNER [--repo PATH|--entity ID]

Use after a manually observed read/gate proof, parking with a wake, or an
explicit handback. The local plan remains task/proof authority; this command
only closes the named owner's root-board claim and advances its resume pointer.
A blocked row needs one local Deferred wake naming the row; a completed row
needs its local PROOF receipt.
EOF
      ;;
    priority)
      cat <<EOF
shadow priority — set one project's global rank on this computer.

usage: shadow priority --value 1..5 [--repo PATH]

The root board owns global priority after import. This locked mutation changes
that value without rewriting any entity PLAN.md; later discovery cannot undo
it. Lower numbers sort first.
EOF
      ;;
    accept)
      cat <<EOF
shadow accept — prove and publish one owned checkpoint, then close its claim.

usage: shadow accept --repo PATH --row '~hash' --by OWNER
       shadow accept --entity ID --repo PATH --row '~hash' --by OWNER
                     --proposal .shadow/evidence/attempt.json
       shadow accept --entity ID --row '~hash' --by OWNER
                     [--timeout-seconds N] [--no-push]

The row's cmd proof starts with a detached checkout of verified committed HEAD
as its working directory; this freezes source state but does not confine the
trusted proof process to that directory. Only on a pass does the row flip to
completed and its PROOF line join the Progress section, in one commit carrying
PLAN.md alone. The flip commit is then pushed to the branch's upstream so other
seats can see the completion;
--no-push keeps it local (and says so), a branch with no upstream stays
local (and says so), and a rejected push exits 3 naming the pull-request
path. For a machine-local entity plan, combine its exact --entity ID with
the --repo checkout whose committed HEAD must pass. A plan with a public Origin
must match that checkout's normalized origin. A local-only source omits private
paths and becomes bound by the first path-free SOURCE receipt instead. Repo-only
input that maps to a machine-local plan is refused rather than guessing among
sibling plans. Detached HEAD is rechecked after proof and immediately before
private publication. --proposal accepts one sealed Codex workspace-write
attempt below --repo/.shadow/evidence, binds its entity, row, owner, canonical
plan root, and source HEAD, then grades the canonical row's structured proof
marker and execution floor. Proposal-enabled rows cannot downgrade into legacy
acceptance, and Git-backed authority does not support proposals. --entity
without --repo remains the path-free recovery
form for a Git-backed completion and still refuses a local plan. read and gate
proofs are person judgments and are refused here.
EOF
      ;;
    lifecycle)
      cat <<EOF
shadow lifecycle — compact a hot plan or retire one exact manifested artifact.

usage: shadow lifecycle [--repo PATH] [--milestone 'exact heading' |
         --progress-before UTC_TIMESTAMP] [--json]
       shadow lifecycle [--repo PATH] --retirement-manifest /ABS/manifest.json [--json]
       shadow lifecycle --apply --repo PATH (--milestone 'exact heading' |
         --progress-before UTC_TIMESTAMP |
         --retirement-manifest /ABS/manifest.json) --expect CAS --by SEAT [--json]

The default is read-only: report the checked-in 256 KiB, 128-task, and
32-milestone budgets and show what one exact archive would change. --repo names
the directory containing the entity's PLAN.md, including a declared nested
entity. A dry run emits the CAS required by --apply; apply also requires the
seat that will attempt the operation-bound successor when one exists. Milestone apply moves the completed
milestone's exact block and Progress receipts to the adjacent docs/plan-archive/, folds
satisfied dependency ids, leaves a non-task tombstone pointer plus a receipt
naming the next open milestone, and commits only PLAN.md plus that archive with
hooks and signing disabled. If the plan remains over budget, another strictly
shrinking archive is the successor; once it is within budget, the first
reachable row is claimed through the computer board.

When no completed milestone is eligible, --progress-before moves only exact
older Progress receipts that name no current task row. Current-row receipts and
newer history stay hot; one digest-bound tombstone preserves the adjacent
archive and exact plan-tree rollback. It creates no database or second ledger.

Dirty, symlinked, malformed, unproven, unregistered non-Git, or colliding targets are
refused. Repeating a successful command with the original CAS is a no-op.
Retirement accepts only the strict schema in schemas/retirement-manifest.v1.json:
every path uses its canonical absolute spelling with no symlink component;
the target is one clean landed non-primary linked worktree without any submodule, or
one clean expired same-entity snapshot
whose HEAD is recoverable from the declared ref. It journals the exact inode,
never uses force, commits a path-free receipt binding the same successor row,
and never discovers a target.
EOF
      ;;
    plan)
      cat <<EOF
shadow plan — migrate or roll back one plan tree or one bounded project map.

usage: shadow plan migrate /ABS/PLAN.md --dry-run [--board /ABS/board.json]
       shadow plan migrate /ABS/PLAN.md --apply --expect SOURCE_SHA256 [--board /ABS/board.json]
       shadow plan rollback /ABS/PLAN.md --expect ROOT_SHA256 [--board /ABS/board.json]
       shadow plan map-migrate /ABS/PLAN.md --dry-run --target-ref REF \\
         --child plans/child/PLAN.md
       shadow plan map-migrate /ABS/PLAN.md --apply --expect TRANSACTION_SHA256 \\
         --receipt /ABS/migration.json --target-ref REF \\
         --child plans/child/PLAN.md
       shadow plan map-rollback /ABS/PLAN.md --apply \\
         --expect APPLIED_SHA256 --receipt /ABS/migration.json

Plan-tree dry-run is the required zero-write first door. Its apply requires the
exact source digest, publishes immutable objects before one root CAS, and
commits a Git-backed root and object tree together. Plan-tree rollback restores
the exact prior root without rewriting board pointers, claims, owners, or
resume.

Project-map migration is a separate bounded transaction. It accepts one exact
registered Git monolith on a clean verified local-only branch and one direct
child commit that changes only the root PLAN.md plus one new declared child
PLAN.md. Row destinations derive from exact target-plan membership; task text,
plan-local dependencies, Contradictions, Progress, project identity, and
priority must be conserved. Apply writes one immutable prepared receipt outside
the repository before mutation, fast-forwards the prepared commit, then uses
one board CAS to add the child entity and rekey mapped claims and resume. The
same apply command resumes safely from that receipt after an interruption.
Rollback resets Git to the exact source HEAD, restores board authority, claims,
resume, and priority, removes the child, and writes an immutable sibling
rollback receipt before mutation; the same rollback command also resumes
safely. Any stale plan, ref, board, claim, receipt, or remote-managed branch is
refused.
EOF
      ;;
    read)
      cat <<EOF
shadow read — project exact verified rows, receipts, or bounded literal matches.

usage: shadow read --entity ENTITY_ID [--row '~hash' ...] \\
  [--receipt progress:N ...] [--find LITERAL ...] \\
  [--expect-root ROOT_SHA256]

The result is one JSON object containing the selected canonical shards verbatim,
their board-issued entity locator, root/index/shard/result digests, and explicit
read budgets. At most eight selectors and 128 KiB of result bytes are allowed.
Each literal find verifies and scans one complete logical plan, but returns at
most 24 matching lines and marks omissions explicitly. The board resolves the
only accepted plan pointer and rejects symlinked locators. The command never follows archive/spill links.
It writes no state, exposes no private plan pointer in error metadata, and returns
no partial content after a missing object or tamper. The result linearizes at the
final pointer/root re-read; later changes belong to the next projection.
projection_sha256 hashes canonical logical JSON without that field, not the
pretty stdout bytes. Legacy monoliths must be migrated before this bounded
surface can read them.
EOF
      ;;
    host)
      cat <<EOF
shadow host — use one native Codex, Claude Code, Cursor, Grok, Z.AI, or Codex-on-Z.AI process.

usage: shadow host probe --host codex|claude-code|cursor|grok|zai|codex-zai [--json]
       shadow host run --host HOST --work-class CLASS --delegation MODE \\
         [--authority-proposal] --repo PATH --task-file PATH \\
         --task-id ID --allowed-path PATH [--allowed-path PATH ...] \\
         [--binary PATH] [--out PATH] [--force] [--timeout-seconds N] [--json]

CLASS is planning, coding, review, or lightweight. MODE is direct or required.
When ~/.shadow/host-defaults.json names a sealed host, work_class, and
delegation triple, those three flags may be omitted. Explicit flags still win.
A missing or invalid file invents nothing: the flags stay required.
Required delegation enables only the host's verified native child capability;
unsupported capability fails closed instead of falling back or fabricating it.
--authority-proposal is a Codex-only no-change pass: it accepts no allowed
paths or binary override, seals source and Git control state, and writes one
proposal receipt beneath .shadow/evidence for later trusted acceptance.
The task file is frozen, the Git worktree must be clean, allowed paths are
exact, and a successful host must emit one shadow.host-receipt.v1 object
with passing tests. The result remains unreviewed until the lead reproduces
it. Which provider or account the host uses is the host CLI's own business —
Shadow records the requested native selector but never an account, credential,
prompt, transcript, or inferred observed model.
EOF
      ;;
    slots)
      cat <<EOF
shadow slots — report which extension slots are filled on this machine.

usage: shadow slots [--json]

A slot is a named capability the Method assumes it can reach.
\`docs/reference/slots.md\` declares each slot and its default filler; nothing
is fetched, installed, or stamped.

Absent is a WARN and exits 0: an optional capability nobody installed is not a
broken install. A wrong binding FAILs. Nothing here reads tooling Shadow does
not itself call — which memory backend you run is your own business.

Override one with SHADOW_SLOT_<NAME>=<path>, or =off to say the emptiness is
deliberate.
EOF
      ;;
    doctor)
      cat <<EOF
shadow doctor — read-only installation and native-host doctor.

usage: shadow doctor [--json] [--help|-h]

Checks product identity, Python, Git, PATH installation, native Codex/Claude
Code/Cursor/Grok availability, those four skill mounts, and whether each host's
instruction file carries the current standing goal. It is read-only and never
fetches, repairs, authenticates, or runs the test suite. Missing optional hosts
or mounts warn; contradictory product identity or mount custody fails.

A standing goal that is absent warns; one that is present but EDITED fails,
because a drifted copy is worse than none — refresh it with \`shadow goal\`.

Each check prints [PASS], [WARN], or [FAIL]. --json emits the same bounded
report. Exit 0 when no hard check fails and 1 otherwise.
EOF
      ;;
    help|"")
      print_top_help
      ;;
    *)
      echo "shadow: unknown command for help: ${cmd}" >&2
      print_top_help >&2
      return 2
      ;;
  esac
}

print_version() {
  # VERSION file may contain trailing notes; the first non-empty,
  # non-comment line is the version string.
  awk 'NF && $1 !~ /^#/ { print; exit }' "${SHADOW_ROOT}/VERSION"
}

# Every subcommand
# below exec's straight into python3/bash/awk against ${SHADOW_ROOT}/scripts
# with no preflight, so a missing python3 or a broken/misdirected SHADOW_ROOT
# (e.g. an env var pointing at an unrelated or incomplete checkout) leaked a
# raw interpreter error ("bash: exec: python3: not found",
# "python3: can't open file ...", "awk: can't open file ...") instead of a
# shadow-authored message. require_shadow_checkout runs once before dispatch
# (help/-h stay exempt -- pure static text, no filesystem access) so every
# subcommand gets the same clear message for the same root cause.
require_shadow_checkout() {
  if [[ ! -f "${SHADOW_ROOT}/VERSION" || ! -d "${SHADOW_ROOT}/scripts" ]]; then
    echo "shadow: SHADOW_ROOT does not look like a shadow checkout: ${SHADOW_ROOT}" >&2
    echo "  Expected a VERSION file and a scripts/ directory under it." >&2
    echo "  If SHADOW_ROOT is set in your environment, unset it or point it at a real shadow checkout." >&2
    exit 127
  fi
}

require_python3() {
  local cmd="$1"
  local resolved
  if ! resolved="$(SHADOW_PYTHON_COMMAND="${cmd}" "${SHADOW_ROOT}/scripts/shadow-python.sh" --print)"; then
    exit 127
  fi
  SHADOW_PYTHON="${resolved}"
  export SHADOW_PYTHON
}

main() {
  if [[ $# -eq 0 ]]; then
    print_top_help
    exit 0
  fi

  local cmd="$1"
  shift || true

  if [[ "${cmd}" != "--help" && "${cmd}" != "-h" && "${cmd}" != "help" ]]; then
    require_shadow_checkout
  fi

  case "${cmd}" in
    --version|-v)
      print_version
      ;;
    --help|-h|help)
      if [[ $# -gt 0 ]]; then
        print_subcommand_help "$1"
      else
        print_top_help
      fi
      ;;
    browse)
      require_python3 "browse"
      export SHADOW_ROOT
      exec "${SHADOW_ROOT}/bin/shadow-browse" "$@"
      ;;
    status)
      require_python3 "status"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-status.py" "$@"
      ;;
    init)
      require_python3 "init"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-init.py" "$@"
      ;;
    lint)
      require_python3 "lint"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-lint.py" "$@"
      ;;
    config)
      require_python3 "config"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow_config.py" "$@"
      ;;
    goal)
      # --install writes it into the host files; bare `goal` prints it.
      if [[ "${1:-}" == "--install" || "${1:-}" == "--remove" ]]; then
        require_python3 "goal"
        [[ "${1}" == "--install" ]] && shift
        exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-host-directives.py" "$@"
      fi
      # One source of truth: the block lives in the doc a person reads, and
      # this extracts it rather than keeping a second copy that drifts. The
      # anchor is ASCII on purpose — the heading's em-dash is multi-byte and
      # would make the pattern depend on the runner's awk locale.
      exec awk '/^## Shadow /{f=1} f&&/^```$/{exit} f' \
        "${SHADOW_ROOT}/docs/reference/host-integration.md"
      ;;
    amp)
      require_python3 "amp"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-amp.py" "$@"
      ;;
    throw)
      require_python3 "throw"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-throw.py" "$@"
      ;;
    return)
      require_python3 "return"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-return.py" "$@"
      ;;
    priority)
      require_python3 "priority"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-priority.py" "$@"
      ;;
    accept)
      require_python3 "accept"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-accept.py" "$@"
      ;;
    lifecycle)
      require_python3 "lifecycle"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-lifecycle.py" "$@"
      ;;
    plan)
      require_python3 "plan"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-plan.py" "$@"
      ;;
    read)
      require_python3 "read"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-read.py" "$@"
      ;;
    host)
      require_python3 "host"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-host.py" "$@"
      ;;
    slots)
      require_python3 "slots"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-slots.py" "$@"
      ;;
    doctor)
      require_python3 "doctor"
      export SHADOW_ROOT
      export SHADOW_DOCTOR_EXPECTED_CLI="${SHADOW_ROOT}/bin/shadow"
      exec "${SHADOW_PYTHON}" "${SHADOW_ROOT}/scripts/shadow-doctor.py" "$@"
      ;;
    *)
      echo "shadow: unknown command: ${cmd}" >&2
      echo >&2
      print_top_help >&2
      exit 2
      ;;
  esac
}

main "$@"
