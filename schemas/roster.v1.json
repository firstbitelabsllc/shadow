{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadow.roster.v1",
  "title": "Shadow Local Roster v1",
  "description": "A local, provider-neutral role roster. It contains only slot identifiers, roles, native host surfaces, ordering, and enabled state; it never carries credentials, accounts, model names, prompts, paths, or provider payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "slots"],
  "properties": {
    "schema": {
      "const": "shadow.roster.v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "host", "priority", "enabled"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,63}$"
          },
          "role": {
            "enum": ["lead", "planner", "bulk", "debug", "critic", "hard-ic"]
          },
          "host": {
            "enum": ["codex", "claude-code", "cursor", "manual"]
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
