{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shadow.decision-choice.v1",
  "title": "Shadow Decision Choice v1",
  "description": "Ephemeral typed answer from a native on-the-go client to the host that owns one shadow.outcome.v1 document. It does not execute work, route providers, or persist mission state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "revision", "outcome_id", "ask_id", "option_id"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "shadow.decision-choice.v1"
    },
    "kind": {
      "type": "string",
      "const": "answer"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "outcome_id": {
      "$ref": "outcome-choice.v1.json#/$defs/id"
    },
    "ask_id": {
      "$ref": "outcome-choice.v1.json#/$defs/id"
    },
    "option_id": {
      "$ref": "outcome-choice.v1.json#/$defs/id"
    }
  }
}
