{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidux.dev/schemas/lifecycle-receipt.v1.json",
  "title": "Vidux lifecycle receipt",
  "description": "A bounded provider-neutral transition receipt for one Outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "outcome_id",
    "plan_revision",
    "updated_at",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "vidux.lifecycle.v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "outcome_id": {
      "$ref": "#/$defs/identifier"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "state": {
      "type": "string",
      "enum": [
        "planned",
        "dispatched",
        "working",
        "needs_you",
        "proving",
        "blocked",
        "finished_with_proof",
        "not_delivered",
        "handed_off"
      ]
    },
    "actor": {
      "type": "string",
      "enum": [
        "pilot",
        "native_host",
        "user",
        "system"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_state",
        "to_state",
        "at",
        "actor",
        "summary",
        "proof_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "from_state": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/state"
            }
          ]
        },
        "to_state": {
          "$ref": "#/$defs/state"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280,
          "pattern": "^(?s:.*\\S.*)$"
        },
        "proof_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        }
      }
    }
  }
}
