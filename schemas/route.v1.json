{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilot-puppy.dev/schemas/route.v1.json",
  "title": "Pilot Puppy Route v1",
  "description": "A local, non-executing role route bound to one frozen task and roster revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "status",
    "binding",
    "requested",
    "selection",
    "alternatives",
    "escalation",
    "execution",
    "blocked"
  ],
  "properties": {
    "schema": {"const": "pilot-puppy.route.v1"},
    "revision": {"const": 1},
    "status": {"enum": ["ready", "manual", "blocked"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_sha256", "roster_revision", "route_roster_sha256"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "task_sha256": {"$ref": "#/$defs/sha256"},
        "roster_revision": {"type": "integer", "minimum": 1},
        "route_roster_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_kind", "role", "host", "availability"],
      "properties": {
        "task_kind": {"oneOf": [{"type": "null"}, {"enum": ["plan", "hard-dev", "dev", "debug", "review", "lead"]}]},
        "role": {"enum": ["lead", "planner", "bulk", "debug", "critic", "hard-ic"]},
        "host": {"oneOf": [{"type": "null"}, {"enum": ["codex", "claude-code", "cursor", "manual"]}]},
        "availability": {"enum": ["probe", "assume"]}
      }
    },
    "selection": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "host", "priority", "state", "reason"],
          "properties": {
            "role": {"enum": ["lead", "planner", "bulk", "debug", "critic", "hard-ic"]},
            "host": {"enum": ["codex", "claude-code", "cursor", "manual"]},
            "priority": {"type": "integer", "minimum": 1, "maximum": 1000},
            "state": {"enum": ["available", "unprobed", "manual"]},
            "reason": {"enum": ["highest_enabled_priority", "explicit_host_constraint"]}
          }
        }
      ]
    },
    "alternatives": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/alternative"}
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "when"],
      "properties": {
        "role": {"enum": ["lead", "planner", "bulk", "debug", "critic", "hard-ic"]},
        "when": {"type": "string", "minLength": 1, "maxLength": 280}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performed", "automatic_reroute", "next_action"],
      "properties": {
        "performed": {"const": false},
        "automatic_reroute": {"const": false},
        "next_action": {"enum": ["explicit_host_run", "lead_manual_handoff", "choose_or_configure_a_same_role_slot"]}
      }
    },
    "blocked": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "summary"],
          "properties": {
            "kind": {"enum": ["no_declared_slot", "no_available_slot"]},
            "summary": {"type": "string", "minLength": 1, "maxLength": 280}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {
        "properties": {
          "selection": {"type": "null"},
          "blocked": {"not": {"type": "null"}},
          "execution": {"properties": {"next_action": {"const": "choose_or_configure_a_same_role_slot"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "ready"}}},
      "then": {
        "properties": {
          "selection": {
            "type": "object",
            "properties": {
              "host": {"enum": ["codex", "claude-code", "cursor"]},
              "state": {"enum": ["available", "unprobed"]}
            }
          },
          "blocked": {"type": "null"},
          "execution": {"properties": {"next_action": {"const": "explicit_host_run"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "manual"}}},
      "then": {
        "properties": {
          "selection": {
            "type": "object",
            "properties": {
              "host": {"const": "manual"},
              "state": {"const": "manual"}
            }
          },
          "blocked": {"type": "null"},
          "execution": {"properties": {"next_action": {"const": "lead_manual_handoff"}}}
        }
      }
    },
    {
      "if": {"properties": {"requested": {"properties": {"task_kind": {"const": "plan"}}}}},
      "then": {"properties": {"requested": {"properties": {"role": {"const": "planner"}}}}}
    },
    {
      "if": {"properties": {"requested": {"properties": {"task_kind": {"const": "hard-dev"}}}}},
      "then": {"properties": {"requested": {"properties": {"role": {"const": "hard-ic"}}}}}
    },
    {
      "if": {"properties": {"requested": {"properties": {"task_kind": {"const": "dev"}}}}},
      "then": {"properties": {"requested": {"properties": {"role": {"const": "bulk"}}}}}
    },
    {
      "if": {"properties": {"requested": {"properties": {"task_kind": {"const": "debug"}}}}},
      "then": {"properties": {"requested": {"properties": {"role": {"const": "debug"}}}}}
    },
    {
      "if": {"properties": {"requested": {"properties": {"task_kind": {"const": "review"}}}}},
      "then": {"properties": {"requested": {"properties": {"role": {"const": "critic"}}}}}
    },
    {
      "if": {"properties": {"requested": {"properties": {"task_kind": {"const": "lead"}}}}},
      "then": {"properties": {"requested": {"properties": {"role": {"const": "lead"}}}}}
    },
    {
      "if": {"properties": {"requested": {"properties": {"role": {"const": "lead"}}}}},
      "then": {"$ref": "#/$defs/requested_lead"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"role": {"const": "planner"}}}}},
      "then": {"$ref": "#/$defs/requested_planner"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"role": {"const": "bulk"}}}}},
      "then": {"$ref": "#/$defs/requested_bulk"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"role": {"const": "debug"}}}}},
      "then": {"$ref": "#/$defs/requested_debug"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"role": {"const": "critic"}}}}},
      "then": {"$ref": "#/$defs/requested_critic"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"role": {"const": "hard-ic"}}}}},
      "then": {"$ref": "#/$defs/requested_hard_ic"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"host": {"type": "null"}}}}},
      "then": {"$ref": "#/$defs/unconstrained_selection"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"host": {"const": "codex"}}}}},
      "then": {"$ref": "#/$defs/codex_selection"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"host": {"const": "claude-code"}}}}},
      "then": {"$ref": "#/$defs/claude_code_selection"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"host": {"const": "cursor"}}}}},
      "then": {"$ref": "#/$defs/cursor_selection"}
    },
    {
      "if": {"properties": {"requested": {"properties": {"host": {"const": "manual"}}}}},
      "then": {"$ref": "#/$defs/manual_selection"}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_lead": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"role": {"const": "lead"}}}]},
        "alternatives": {"items": {"type": "object", "properties": {"role": {"const": "lead"}}}}
      }
    },
    "requested_planner": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"role": {"const": "planner"}}}]},
        "alternatives": {"items": {"type": "object", "properties": {"role": {"const": "planner"}}}}
      }
    },
    "requested_bulk": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"role": {"const": "bulk"}}}]},
        "alternatives": {"items": {"type": "object", "properties": {"role": {"const": "bulk"}}}}
      }
    },
    "requested_debug": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"role": {"const": "debug"}}}]},
        "alternatives": {"items": {"type": "object", "properties": {"role": {"const": "debug"}}}}
      }
    },
    "requested_critic": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"role": {"const": "critic"}}}]},
        "alternatives": {"items": {"type": "object", "properties": {"role": {"const": "critic"}}}}
      }
    },
    "requested_hard_ic": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"role": {"const": "hard-ic"}}}]},
        "alternatives": {"items": {"type": "object", "properties": {"role": {"const": "hard-ic"}}}}
      }
    },
    "unconstrained_selection": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"reason": {"const": "highest_enabled_priority"}}}]}
      }
    },
    "codex_selection": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"host": {"const": "codex"}, "reason": {"const": "explicit_host_constraint"}}}]}
      }
    },
    "claude_code_selection": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"host": {"const": "claude-code"}, "reason": {"const": "explicit_host_constraint"}}}]}
      }
    },
    "cursor_selection": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"host": {"const": "cursor"}, "reason": {"const": "explicit_host_constraint"}}}]}
      }
    },
    "manual_selection": {
      "properties": {
        "selection": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"host": {"const": "manual"}, "reason": {"const": "explicit_host_constraint"}}}]}
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "host", "state", "reason"],
      "properties": {
        "role": {"enum": ["lead", "planner", "bulk", "debug", "critic", "hard-ic"]},
        "host": {"enum": ["codex", "claude-code", "cursor", "manual"]},
        "state": {"enum": ["available", "unprobed", "manual", "disabled", "unavailable"]},
        "reason": {"enum": ["lower_roster_priority", "disabled", "unavailable"]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"enum": ["available", "unprobed", "manual"]}}},
          "then": {"properties": {"reason": {"const": "lower_roster_priority"}}}
        },
        {
          "if": {"properties": {"state": {"const": "disabled"}}},
          "then": {"properties": {"reason": {"const": "disabled"}}}
        },
        {
          "if": {"properties": {"state": {"const": "unavailable"}}},
          "then": {"properties": {"reason": {"const": "unavailable"}}}
        }
      ]
    }
  }
}
