{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pilot-puppy.dev/schemas/decision-receipt.v1.json",
  "title": "Pilot Puppy Decision Receipt v1",
  "description": "A bounded local compare-and-set receipt for one typed Decision choice. It does not claim execution or route a provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "reason",
    "observed_revision",
    "authority_revision",
    "outcome_id",
    "ask_id",
    "option_id"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "pilot-puppy.decision-receipt.v1"
    },
    "state": {
      "type": "string",
      "enum": ["received", "superseded", "not_delivered"]
    },
    "reason": {
      "type": "string",
      "enum": [
        "accepted",
        "stale_revision",
        "option_not_visible",
        "identity_mismatch"
      ]
    },
    "observed_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "authority_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "outcome_id": {
      "$ref": "outcome-choice.v1.json#/$defs/id"
    },
    "ask_id": {
      "$ref": "outcome-choice.v1.json#/$defs/id"
    },
    "option_id": {
      "$ref": "outcome-choice.v1.json#/$defs/id"
    }
  }
}
