{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidux.dev/schemas/outcome-ask-steer.v1.json",
  "title": "Vidux Outcome Ask Steer v1",
  "description": "Provider-neutral interchange document for one Outcome, optional Ask, Steers, and proof references. Validates bounded semantic shape only; does not execute work, route models, persist state, or contact a provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "updated_at",
    "outcome",
    "ask",
    "steers",
    "proof"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "vidux.outcome.v1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "updated_at": {
      "$ref": "#/$defs/rfc3339Utc"
    },
    "outcome": {
      "$ref": "#/$defs/outcome"
    },
    "ask": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/ask" }
      ]
    },
    "steers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/steer"
      }
    },
    "proof": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/proofReference"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,63}$"
    },
    "nonblank80": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[\\S\\s]*\\S[\\S\\s]*$"
    },
    "nonblank280": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "^[\\S\\s]*\\S[\\S\\s]*$"
    },
    "nonblank500": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[\\S\\s]*\\S[\\S\\s]*$"
    },
    "rfc3339Utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "oneOf": [
        {
          "description": "https URL",
          "type": "string",
          "pattern": "^https://[^\\s]{1,505}$"
        },
        {
          "description": "Repository-relative path with no .. segment",
          "type": "string",
          "pattern": "^(?!\\.\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,511}$"
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "state", "current_move"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "summary": { "$ref": "#/$defs/nonblank280" },
        "state": {
          "type": "string",
          "enum": [
            "working",
            "needs_input",
            "blocked",
            "finished_with_proof",
            "not_delivered"
          ]
        },
        "current_move": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/nonblank280" }
          ]
        }
      }
    },
    "askOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "consequence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/nonblank80" },
        "consequence": { "$ref": "#/$defs/nonblank280" }
      }
    },
    "ask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "question",
        "options",
        "state",
        "answer_option_id"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "category": {
          "type": "string",
          "enum": [
            "product_choice",
            "security",
            "money",
            "external_communication",
            "irreversible_action"
          ]
        },
        "question": { "$ref": "#/$defs/nonblank280" },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/askOption" },
          "uniqueItems": true
        },
        "state": {
          "type": "string",
          "enum": ["open", "answered", "superseded"]
        },
        "answer_option_id": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        }
      }
    },
    "steer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outcome_id", "summary", "state", "proof_ref"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "outcome_id": { "$ref": "#/$defs/identifier" },
        "summary": { "$ref": "#/$defs/nonblank280" },
        "state": {
          "type": "string",
          "enum": [
            "received",
            "applied",
            "working",
            "blocked",
            "finished_with_proof",
            "not_delivered",
            "superseded"
          ]
        },
        "proof_ref": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        }
      }
    },
    "proofReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "locator",
        "verification_summary",
        "delivery"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "type": {
          "type": "string",
          "enum": ["test", "runtime", "ui", "release", "document", "other"]
        },
        "locator": { "$ref": "#/$defs/locator" },
        "verification_summary": { "$ref": "#/$defs/nonblank500" },
        "delivery": {
          "type": "string",
          "enum": ["delivered", "not_delivered"]
        }
      }
    }
  }
}
